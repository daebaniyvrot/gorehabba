{
  "name": "garehabba",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Гарехабба — 3D фестиваль. Браузерная игра на Three.js без сборки.",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:prod": "bash tests/prod/run.sh"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "three": "^0.160.0"
  }
}
